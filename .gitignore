# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# IDEs / editors
.idea/
.vscode/

# Packaging/build outputs
dist/
build/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS files
.DS_Store
Thumbs.db

# Temporary / lock files (Office, etc.)
~$*

# Data artifacts (keep tracked files explicitly if needed)
*.pkl

# Generated figures (keep folder via .gitkeep)
figures/*
!figures/.gitkeep

# Generated results/tables (keep folder via .gitkeep)
results/*
!results/.gitkeep

# LaTeX build outputs (keep folder via .gitkeep)
documents/build/*
!documents/build/.gitkeep
documents/*.aux
documents/*.bbl
documents/*.blg
documents/*.fdb_latexmk
documents/*.fls
documents/*.log
documents/*.out
documents/*.synctex.gz
documents/*.toc
